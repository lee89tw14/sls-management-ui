# SLS Management UI Environment Variables

# Base URL for the API server
# This will be used by the React app to make API calls
# For direct IP access: http://your-server-ip:8080
# For nginx proxy: leave empty for dynamic detection or set to your domain
APP_URL=http://localhost:8080

# Ports
SRT_PLAYER_PORT=4000
SRT_SENDER_PORT=4001
SLS_STATS_PORT=8080
SRTLA_PORT=5000

# API Proxy Path (for nginx reverse proxy setups)
# If using nginx to proxy API requests, set this to the proxy path
# Example: /api (if nginx proxies /api/* to backend:8080/*)
# Leave empty for automatic detection based on access method
# REACT_APP_API_PROXY_PATH=/api

