# SLS Management UI configuration
#
# All values are read when the container starts (no rebuild needed). After a
# change, recreate the container (docker compose up -d, or "Update the stack" in
# Portainer). Leave a value empty to use the default.
# The legacy REACT_APP_* names (REACT_APP_BASE_URL, REACT_APP_SRT_PLAYER_PORT, ...)
# are still accepted.

# --- Addresses ---------------------------------------------------------------
# Host values may be a full URL (https://api.example.com, http://10.0.0.5:8080)
# or a bare host (10.0.0.5, api.example.com:8080); bare hosts get http:// and,
# without a port, SLS_STATS_PORT.

# Where the browser sends /api, /health and /stats requests.
# Empty = automatic:
#   page opened via IP, localhost or an explicit port (http://192.168.1.10:3000,
#   http://box.tailnet.ts.net:3000)  -> http://<same host>:SLS_STATS_PORT
#   page opened via a host name without port (https://srt.example.com)
#                                    -> same origin (reverse proxy / tunnel must
#                                       forward /api, /health and /stats to SLS)
API_HOST=

# Base of the statistics links shown in the UI (e.g. for NOALBS). Empty = API_HOST / automatic.
STATS_HOST=

# Host name used in srt:// and srtla:// URLs. Must reach the receiver's UDP ports,
# so set it when the UI is reached through an HTTP-only proxy or tunnel.
# Empty = host of APP_URL, otherwise the host the page was opened with.
SRT_HOST=

# Legacy all-in-one setting: sets API_HOST, STATS_HOST and SRT_HOST at once
# (each can still be overridden individually).
APP_URL=

# --- Ports -------------------------------------------------------------------
SRT_PLAYER_PORT=4000
SRT_SENDER_PORT=4001
SLS_STATS_PORT=8080
# Leave empty to hide SRTLA URLs.
SRTLA_PORT=5000
